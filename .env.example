# Telegram API credentials — get from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# StringSession — generated by: npm run login
TELEGRAM_SESSION=

# Source channel to monitor for TeraBox links
SOURCE_CHANNEL_ID=-1003574098343

# Auto-MD / TeraBox downloader bot
PROCESSING_BOT_ID=8308228789

# Destination channel for clean video uploads
DESTINATION_CHANNEL_ID=-1003897175553

# Comma-separated TeraBox domain allowlist
TERABOX_DOMAINS=terabox.com,www.terabox.com,teraboxapp.com,www.teraboxapp.com

# Serial processing — do NOT increase above 1 unless Auto-MD adds request correlation
MAX_CONCURRENT_JOBS=1

# Timeout waiting for Auto-MD to return a video (minutes)
VIDEO_TIMEOUT_MINUTES=15

# Maximum retry attempts per job
MAX_RETRIES=2

# Temporary directory for video downloads
TEMP_DIR=./tmp

# SQLite database path
DATABASE_PATH=./data/jobs.sqlite

# Logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
